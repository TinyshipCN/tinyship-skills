# Minimal per-round .env for directory acceptance. acceptance.sh fills the
# placeholders; copy by hand only if you run steps yourself.
APP_BASE_URL=http://localhost:__PORT__
BETTER_AUTH_URL=http://localhost:__PORT__
BETTER_AUTH_SECRET="__SECRET__"
DB_DIALECT="__DIALECT__"
# drizzle.config.ts needs this even for sqlite / d1 rounds (db:generate)
DATABASE_URL="__DATABASE_URL__"
SQLITE_DB_PATH=./data/local.sqlite
# lets build:next pass without storage / provider keys
BUILD_TIME=true
